# MongoDB Atlas connection string (never commit the real value — this file only documents the shape).
# Copy this file to .env.local and fill in your own credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=autorwa

# Auth.js secret used to sign/encrypt session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth, for the "Continue with Google" button. Create a client at
# https://console.cloud.google.com/apis/credentials (OAuth client ID, type
# "Web application") with an authorized redirect URI of:
#   <your-site-url>/api/auth/callback/google
# Leave blank to disable — the button still renders but sign-in will fail
# with a config error until these are set. Note: today this only lets
# Google sign-in link to an email that already has a password-based
# account (see the signIn callback in src/lib/auth/auth.ts) — it doesn't
# yet create brand-new accounts, since the User model requires a password.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Support contact number shown in the floating WhatsApp/Call widget (public
# storefront pages). Digits with country code, e.g. 250788000000 — the `+`
# and spaces are stripped automatically, so either format works. Leave both
# blank to hide the widget entirely. NEXT_PUBLIC_* vars are inlined into the
# client bundle at build time, so restart `next dev` after changing these.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Only needed if the call number differs from the WhatsApp number above.
NEXT_PUBLIC_SUPPORT_PHONE=

# Social links shown in the footer. Full profile/page URLs. Leave any of
# these blank to omit that icon — the footer's WhatsApp icon reuses
# NEXT_PUBLIC_SUPPORT_WHATSAPP above instead of a separate var.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_TIKTOK=
