# MongoDB Atlas connection string (never commit the real value — this file only documents the shape).
# Copy this file to .env.local and fill in your own credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=autorwa

# Auth.js secret used to sign/encrypt session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Support contact number shown in the floating WhatsApp/Call widget (public
# storefront pages). Digits with country code, e.g. 250788000000 — the `+`
# and spaces are stripped automatically, so either format works. Leave both
# blank to hide the widget entirely. NEXT_PUBLIC_* vars are inlined into the
# client bundle at build time, so restart `next dev` after changing these.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Only needed if the call number differs from the WhatsApp number above.
NEXT_PUBLIC_SUPPORT_PHONE=
